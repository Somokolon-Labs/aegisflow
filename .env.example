# ---------------------------------------------------------------------------
# AegisFlow configuration. Copy to .env and adjust.
# The defaults below run the whole platform on a laptop with no extra services.
# ---------------------------------------------------------------------------

APP_ENV=local
VERSION=1.0.0
LOG_LEVEL=INFO
LOG_JSON=true

# ---- storage --------------------------------------------------------------
# laptop / single node
DATABASE_URL=sqlite+aiosqlite:///./data/aegisflow.db
# managed Postgres (Neon, RDS, Supabase...) - asyncpg URL is derived automatically
# DATABASE_URL=postgresql://user:password@host/dbname

# ---- broker ---------------------------------------------------------------
# db    -> durable queue in Postgres/SQLite, zero extra infrastructure
# redis -> Redis Streams consumer groups
# kafka -> Kafka / Redpanda, manual offset commits (production default)
BROKER=db
KAFKA_BOOTSTRAP=localhost:19092
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
CONSUMER_GROUP=inference-workers
VISIBILITY_TIMEOUT_S=45

# ---- security -------------------------------------------------------------
REQUIRE_API_KEY=true
API_KEYS=demo-key-aegisflow,partner-key-aegisflow
ADMIN_API_KEY=admin-key-aegisflow
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=12000
RATE_LIMIT_BURST=800

# ---- worker ---------------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_PREFETCH=16
MAX_ATTEMPTS=4
JOB_TIMEOUT_MS=5000
RETRY_BASE_MS=250
RETRY_MAX_MS=8000
ARTIFACTS_DIR=ml/artifacts

# ---- service wiring -------------------------------------------------------
GATEWAY_URL=http://localhost:8000
LAB_URL=http://localhost:8100
METRICS_PORT=9101
RETENTION_HOURS=72
