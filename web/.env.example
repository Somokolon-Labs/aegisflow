# Console configuration
#
# Demo mode (default): the UI runs against an in-browser simulator, which is how
# the public portfolio deployment works. Nothing else is needed.
NEXT_PUBLIC_USE_MOCKS=true

# Live mode: point at a running gateway and turn mocks off.
# NEXT_PUBLIC_USE_MOCKS=false
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_DEMO_API_KEY=demo-key-aegisflow
# NEXT_PUBLIC_DEMO_ADMIN_KEY=admin-key-aegisflow
